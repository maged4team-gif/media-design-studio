# ==============================================================================
# Environment Configuration - Media Design Studio Showcase
# ==============================================================================

# Data Mode: REQUIRED. Explicitly set to either 'demo' (for local JSON store) or 'supabase' (for PostgreSQL).
# Implicit fallback to demo is forbidden.
DATA_MODE=demo

# Supabase Credentials (REQUIRED when DATA_MODE=supabase, forbidden in production with DATA_MODE=demo)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-secret-key>

# Single Admin Master Password (for /admin login)
# Minimum 10 characters required in production. Must NOT be an example placeholder.
ADMIN_PASSWORD=<change-this-to-a-secure-admin-password>

# Secret used to sign client and admin HTTP-only session cookies
# Cryptographically secure random string of at least 32 characters in production.
# Generate via: openssl rand -base64 32
SESSION_SECRET=<generate-at-least-32-chars-cryptographic-random-secret>

# Google Cloud & Google Drive Integration
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://<your-domain>/api/admin/drive/oauth/callback
GOOGLE_DRIVE_REFRESH_TOKEN=<your-google-drive-refresh-token>
GOOGLE_DRIVE_ROOT_FOLDER_ID=<your-google-drive-root-folder-id>

